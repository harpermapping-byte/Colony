# Copia este archivo a "server/.env" (NUNCA lo subas a git — ya está en
# .gitignore) y rellena lo que necesites. server/src/index.ts carga este
# archivo automáticamente al arrancar (import "dotenv/config").
#
# Ver docs/GDD_Despliegue_Local.md para la guía completa de hosting 24/7
# desde un PC propio (Windows + pm2 + Cloudflare Tunnel + Neon Postgres).

# --- Base de datos ---
# Si DATABASE_URL está definida, el servidor usa Postgres (Neon) — hace falta
# para un hosting 24/7 real (SQLite bloquea el hilo único de Node bajo
# ráfagas de reconexión, ver server/src/datos/bd.ts). Si se deja vacía, cae a
# SQLite local (server/datos.sqlite) — válido solo para pruebas.
DATABASE_URL=

# --- Servidor ---
# Puerto donde escucha Colyseus (por detrás del túnel/proxy, nunca expuesto
# directo a internet).
PORT=2567

# --- Cliente (Vercel) ---
# Usado para CORS y para el redirect final del login de Twitch.
CLIENT_URL=

# --- Jarl / permisos de admin ---
# Nombres de personaje con permisos de jarl "de toda la vida", separados por
# coma (además de las cuentas admin normales).
JARL_NOMBRES=

# --- Twitch (opcional — todo lo que dependa de esto es no-op si falta) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CANAL=
TWITCH_BOT_USERNAME=
TWITCH_BOT_TOKEN=
TWITCH_REDIRECT_URI=

# --- IA de diálogo de NPCs (opcional — fallback determinista si faltan) ---
GEMINI_API_KEY=
GROQ_API_KEY=
