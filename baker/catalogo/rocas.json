  "escombros_acantilado": { "uso": "pedido 2026-08-29 (\"escombros al pie de los acantilados, como los arbustos, dan piedra al picarse\"): sale por el decorador de densidad NORMAL (no la colocación determinista de roca_acantilado_*) — requiereAcantilado reusa el mismo detector de pendiente ya construido para las rocas de acantilado grandes. Categoría piedra_comun: cascotes/piedra suelta acumulada al pie de una ladera real.", "colision": true, "requiereAcantilado": true, "biomas": ["pradera", "bosque", "montana_nevada", "desierto", "pantano", "costa"], "categoriaRecurso": "piedra_comun", "densidadBase": 0.02, "escalaRuido": 8, "variantes": 5, "colorDebug": "#7a726a", "desaparaceAlRecolectar": true },

